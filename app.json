{
  "expo": {
    "name": "Memora",
    "slug": "memora",
    "version": "2.3.0",
    "platforms": ["web"],
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "scheme": "memora",
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "Memora",
      "shortName": "Memora",
      "themeColor": "#07090E",
      "backgroundColor": "#07090E",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-web-browser",
      "expo-font",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
