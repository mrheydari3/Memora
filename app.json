{
  "expo": {
    "name": "Memora",
    "slug": "memora",
    "version": "3.0.0",
    "platforms": ["web"],
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "scheme": "memora",
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "Memora",
      "shortName": "Memora",
      "themeColor": "#07090E",
      "backgroundColor": "#07090E",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/",
      "splash": {
        "image": "/splash-icon-v4.png",
        "resizeMode": "contain",
        "backgroundColor": "#07090E"
      }
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": false
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      "expo-font",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
