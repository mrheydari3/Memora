{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "types": ["node"],
    "paths": {
      "@/*": ["./*"],
      "@components/*": ["components/*"],
      "@store/*": ["store/*"],
      "@data/*": ["data/*"],
      "@services/*": ["services/*"],
      "@theme/*": ["theme/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "nativewind-env.d.ts"]
}
